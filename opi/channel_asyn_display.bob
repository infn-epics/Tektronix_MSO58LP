<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Channel $(CHAN) Waveform</name>
  <width>920</width>
  <height>932</height>
  <background_color>
    <color red="240" green="240" blue="240">
    </color>
  </background_color>
  <grid_step_x>5</grid_step_x>
  <grid_step_y>5</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Channel $(CHAN) Waveform</text>
    <x>6</x>
    <y>6</y>
    <width>250</width>
    <height>28</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="18.0">
      </font>
    </font>
    <foreground_color>
      <color red="0" green="0" blue="128">
      </color>
    </foreground_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Title_Label</name>
    <pv_name>pva://$(P):CH$(CHAN):Label_RBV</pv_name>
    <x>260</x>
    <y>8</y>
    <width>150</width>
    <height>24</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="16.0">
      </font>
    </font>
    <foreground_color>
      <color red="100" green="100" blue="100">
      </color>
    </foreground_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Title_Prefix</name>
    <text>$(P)</text>
    <x>550</x>
    <y>10</y>
    <width>250</width>
    <height>22</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
    <foreground_color>
      <color red="140" green="140" blue="140">
      </color>
    </foreground_color>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>En_CH</name>
    <pv_name>pva://$(P):CH$(CHAN):Enable</pv_name>
    <label>Enable</label>
    <x>820</x>
    <y>8</y>
    <width>90</width>
    <height>24</height>
  </widget>
  <widget type="xyplot" version="3.0.0">
    <name>Waveform_Plot</name>
    <x>6</x>
    <y>34</y>
    <width>908</width>
    <height>380</height>
    <background_color>
      <color red="0" green="0" blue="0">
      </color>
    </background_color>
    <title>CH$(CHAN) Waveform</title>
    <title_font>
      <font family="Liberation Sans" style="BOLD" size="13.0">
      </font>
    </title_font>
    <show_toolbar>true</show_toolbar>
    <rules>
      <rule name="maxx" prop_id="x_axis.maximum" out_exp="true">
        <exp bool_exp="pvInt0&gt;0">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>pva://$(P):CH$(CHAN):NrPt</pv_name>
      </rule>
    </rules>
    <x_axis>
      <title>Samples (window relative)</title>
      <autoscale>false</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>10.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font family="Liberation Sans" style="BOLD" size="11.0">
        </font>
      </title_font>
      <scale_font>
        <font family="Liberation Sans" style="REGULAR" size="10.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Amplitude (V)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>-1.0</minimum>
        <maximum>1.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font family="Liberation Sans" style="BOLD" size="11.0">
          </font>
        </title_font>
        <scale_font>
          <font family="Liberation Sans" style="REGULAR" size="10.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>CH$(CHAN)</name>
        <x_pv />
        <y_pv>pva://$(P):CH$(CHAN):Waveform</y_pv>
        <err_pv />
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="200" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>0</point_size>
        <visible>true</visible>
      </trace>
    </traces>
    <marker>
      <marker>
        <color>
          <color red="0" green="100" blue="255">
          </color>
        </color>
        <pv_name>pva://$(P):CH$(CHAN):MarkerStartPt</pv_name>
        <interactive>true</interactive>
        <visible>true</visible>
      </marker>
      <marker>
        <color>
          <color red="255" green="50" blue="50">
          </color>
        </color>
        <pv_name>pva://$(P):CH$(CHAN):MarkerEndPt</pv_name>
        <interactive>true</interactive>
        <visible>true</visible>
      </marker>
    </marker>
  </widget>
